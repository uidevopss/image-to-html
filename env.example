# Copy this file to .env and fill in your key, then restart `npm run dev`.
# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=AQ.Ab8RN6KXvZjxkl0MJK2RfWY4x_lpEzws689Hy4Y8qbckOqKC0Q

# Main model
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: extra comma-separated models to try if the main model is overloaded (503/429).
# gemini-2.5-flash and gemini-2.5-flash-lite are always tried last, so this can stay empty.
VITE_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Optional: seconds-to-milliseconds limit for one request before switching model (default 60000)
# VITE_GEMINI_TIMEOUT_MS=60000
